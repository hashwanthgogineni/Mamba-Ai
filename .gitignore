# Godot executables and large files
Godot/**/*.exe
Godot/**/*.app
Godot/**/*.dmg
Godot/**/*.zip

# Generated projects and runtime data (should not be in repo)
core/projects/
core/web_projects/
projects/
web_projects/

# Exported game builds (should not be in repo)
**/exports/*.exe
**/exports/*.app
**/exports/*.pck
**/exports/*.wasm

# Godot cache and build files
**/.godot/
*.import

# Large binary files (over 50MB)
*.exe
!node_modules/**/*.exe

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Environment variables
.env
.env.local
.env.*.local
core/.env

# Generated Godot projects, exports and downloaded art (regenerable, ~700MB)
core/godot_projects/
core/local_storage/
core/asset_cache/
godot_projects/
local_storage/
asset_cache/

# Harnesses the gates write into a project at run time
validate.gd
validate.gd.uid
runtime_check.gd
runtime_check.gd.uid
*.gd.uid
.godot/

